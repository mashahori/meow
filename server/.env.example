# Server port
PORT=

# Allowed client origin for local development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=

# Secret used to sign the session ID cookie
SESSION_SECRET=

# Public client URL used to build password reset links
CLIENT_URL=http://localhost:5173

# Set to true to skip real emails and print the reset link to the server log
MAIL_MOCK=false

# SMTP server used to send password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SESSION_SECRET=